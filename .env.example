# MemoryWeave — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it's in .gitignore.

# ── LLM API keys ─────────────────────────────────────────────────────────────
# Only needed if you're using a hosted LLM adapter (Phase 4).
# Leave empty if you're using Ollama (local models).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Vector store ──────────────────────────────────────────────────────────────
# Only needed if using Qdrant cloud. Local Qdrant and Chroma need no config.

QDRANT_URL=
QDRANT_API_KEY=

# ── MemoryWeave server ────────────────────────────────────────────────────────
# Only needed if running the optional FastAPI server (Phase 6).

MEMORYWEAVE_API_KEY=
MEMORYWEAVE_PORT=8000
